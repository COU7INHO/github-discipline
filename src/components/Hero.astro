---
---

<section id="top" class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-grid"></div>
    <div class="hero-glow"></div>
  </div>

  <div class="hero-inner">
    <h1 class="hero-title">
      <span class="line-1">The</span>
      <span class="line-2"><em>GitHub</em></span>
      <span class="line-3">Discipline.</span>
    </h1>

    <p class="hero-lead">
      A guide for engineering teams who care about <em>how</em> code ships —
      not just that it does. Nine chapters on the habits that turn a repository
      into a craft.
    </p>

    <div class="hero-meta">
      <div class="meta-item">
        <span class="meta-key">For</span>
        <span class="meta-val">Engineers</span>
      </div>
      <div class="meta-divider"></div>
      <div class="meta-item">
        <span class="meta-key">Read time</span>
        <span class="meta-val">~25 min</span>
      </div>
      <div class="meta-divider"></div>
      <div class="meta-item">
        <span class="meta-key">Chapters</span>
        <span class="meta-val">9</span>
      </div>
    </div>

    <div class="hero-cta">
      <a href="#introduction" class="cta-primary">
        <span>Begin reading</span>
        <span class="cta-arrow">→</span>
      </a>
    </div>

    <div class="hero-marginalia">
      <span class="mg-label">A note from the author</span>
      <p class="mg-text">
        Tools don't enforce discipline — teams do. This guide is what I wish someone
        had handed me on day one. Read it, disagree with it, adapt it.
      </p>
    </div>
  </div>

  <div class="hero-scroll" aria-hidden="true">
    <span class="scroll-line"></span>
    <span class="scroll-text">Scroll</span>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 6rem 4rem 4rem;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border-subtle) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-subtle) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.5) 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.5) 0%, transparent 70%);
    opacity: 0.4;
  }

  .hero-glow {
    position: absolute;
    top: 30%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, var(--accent-signature) 0%, transparent 60%);
    opacity: 0.08;
    filter: blur(40px);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 980px;
    width: 100%;
    margin: 0 auto;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--border-default);
    border-radius: 999px;
    background: var(--bg-elev-1);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    margin-bottom: 3rem;
    animation: fade-in 800ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-green);
    box-shadow: 0 0 8px var(--accent-green);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 200;
    line-height: 0.95;
    letter-spacing: -0.045em;
    color: var(--text-primary);
    margin-bottom: 2.5rem;
  }

  .hero-title .line-1,
  .hero-title .line-2,
  .hero-title .line-3 {
    display: block;
    animation: rise 1000ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-title .line-1 { animation-delay: 100ms; }
  .hero-title .line-2 {
    animation-delay: 250ms;
    color: var(--accent-signature);
    font-style: italic;
    font-weight: 300;
    padding-left: 2.5rem;
  }
  .hero-title .line-3 { animation-delay: 400ms; }

  .hero-title em {
    font-style: italic;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .hero-lead {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 640px;
    margin-bottom: 3rem;
    letter-spacing: -0.01em;
    animation: rise 1000ms cubic-bezier(0.16, 1, 0.3, 1) 550ms both;
  }

  .hero-lead em {
    color: var(--accent-signature);
    font-style: italic;
  }

  .hero-meta {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 1.5rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: rgba(13, 17, 23, 0.6);
    backdrop-filter: blur(8px);
    margin-bottom: 3rem;
    animation: rise 1000ms cubic-bezier(0.16, 1, 0.3, 1) 700ms both;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .meta-key {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-dim);
  }

  .meta-val {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .meta-divider {
    width: 1px;
    height: 24px;
    background: var(--border-default);
  }

  .hero-cta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 5rem;
    animation: rise 1000ms cubic-bezier(0.16, 1, 0.3, 1) 850ms both;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.95rem 1.75rem;
    background: var(--text-primary);
    color: var(--bg-base);
    border: 1px solid var(--text-primary);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: -0.005em;
    border-bottom: 1px solid var(--text-primary);
    transition: all 200ms ease;
  }

  .cta-primary:hover {
    background: var(--accent-signature);
    border-color: var(--accent-signature);
    color: var(--bg-base);
    transform: translateY(-1px);
  }

  .cta-arrow {
    transition: transform 200ms ease;
  }

  .cta-primary:hover .cta-arrow {
    transform: translateX(4px);
  }

  .hero-hint {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .hero-hint kbd {
    display: inline-block;
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--border-default);
    border-bottom-width: 2px;
    border-radius: 4px;
    background: var(--bg-elev-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-primary);
    margin: 0 0.15rem;
  }

  .hero-marginalia {
    max-width: 380px;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border-subtle);
    animation: fade-in 1500ms ease 1200ms both;
  }

  .mg-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-signature);
    margin-bottom: 0.75rem;
  }

  .mg-text {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .hero-scroll {
    position: absolute;
    bottom: 2.5rem;
    right: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    z-index: 1;
    animation: fade-in 1000ms ease 1500ms both;
  }

  .scroll-line {
    width: 1px;
    height: 50px;
    background: linear-gradient(180deg, transparent, var(--text-muted));
    animation: scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% { transform: scaleY(0.6); opacity: 0.5; }
    50% { transform: scaleY(1); opacity: 1; }
  }

  .scroll-text {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--text-muted);
    writing-mode: vertical-rl;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 4rem 1.5rem 3rem;
      min-height: 90vh;
    }

    .hero-title .line-2 {
      padding-left: 1rem;
    }

    .hero-meta {
      flex-wrap: wrap;
      gap: 1rem;
    }

    .meta-divider {
      display: none;
    }

    .hero-cta {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero-scroll {
      display: none;
    }
  }
</style>
