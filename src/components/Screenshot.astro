---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  /** Window chrome style: 'browser' (URL bar) or 'app' (minimal) */
  chrome?: 'browser' | 'app';
  url?: string;
}

const { src, alt, caption, chrome = 'browser', url = 'github.com/your-org/your-repo' } = Astro.props;
---

<figure class="screenshot reveal">
  <div class={`screenshot-frame chrome-${chrome}`}>
    {chrome === 'browser' && (
      <div class="chrome-bar">
        <div class="chrome-dots">
          <span></span><span></span><span></span>
        </div>
        <div class="chrome-url">
          <span class="chrome-lock">⌬</span>
          <span class="chrome-url-text">{url}</span>
        </div>
        <div class="chrome-spacer"></div>
      </div>
    )}
    <div class="screenshot-image">
      <img src={src} alt={alt} loading="lazy" />
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .screenshot {
    margin: 2.5rem 0;
  }

  .screenshot-frame {
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-elev-1);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.04) inset,
      0 20px 60px -20px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.02);
    position: relative;
  }

  .screenshot-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    pointer-events: none;
    background: linear-gradient(180deg, rgba(255,255,255,0.04) 0%, transparent 25%);
  }

  .chrome-bar {
    display: grid;
    grid-template-columns: 80px 1fr 80px;
    align-items: center;
    padding: 0.75rem 1rem;
    background: var(--bg-elev-2);
    border-bottom: 1px solid var(--border-subtle);
  }

  .chrome-dots {
    display: flex;
    gap: 0.4rem;
  }

  .chrome-dots span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .chrome-dots span:nth-child(1) { background: #ed6a5e; }
  .chrome-dots span:nth-child(2) { background: #e0c04c; }
  .chrome-dots span:nth-child(3) { background: #62c655; }

  .chrome-url {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-base);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    max-width: 460px;
    margin: 0 auto;
    width: 100%;
    justify-self: center;
  }

  .chrome-lock {
    color: var(--accent-green);
    font-size: 0.7rem;
  }

  .chrome-url-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .screenshot-image {
    background: var(--bg-elev-1);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 280px;
  }

  .screenshot-image img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--text-muted);
    text-align: center;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .screenshot {
      margin: 1.75rem -0.5rem;
    }

    .chrome-bar {
      padding: 0.55rem 0.7rem;
      grid-template-columns: 50px 1fr 0;
    }

    .chrome-dots span {
      width: 8px;
      height: 8px;
    }

    .chrome-url {
      font-size: 0.65rem;
      padding: 0.2rem 0.6rem;
    }

    .screenshot-image {
      min-height: 0;
    }

    figcaption {
      font-size: 0.85rem;
      padding: 0 0.5rem;
    }
  }
</style>
