---
interface Props {
  cols?: 2 | 3;
}
const { cols = 2 } = Astro.props;
---

<div class={`grid grid-${cols}`}>
  <slot />
</div>

<style>
  .grid {
    display: grid;
    gap: 1rem;
    margin: 2rem 0;
  }

  .grid-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 720px) {
    .grid-2, .grid-3 {
      grid-template-columns: 1fr;
    }
  }
</style>
