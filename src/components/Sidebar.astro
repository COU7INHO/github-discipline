---
const chapters = [
  { id: 'introduction', n: '00', label: 'Preface' },
  { id: 'repository-setup', n: '01', label: 'Repository Setup' },
  { id: 'branching-strategy', n: '02', label: 'Branching Strategy' },
  { id: 'issues-first', n: '03', label: 'Issues First' },
  { id: 'working-branches', n: '04', label: 'Working on Branches' },
  { id: 'pull-requests', n: '05', label: 'Pull Requests' },
  { id: 'code-review', n: '06', label: 'Code Review' },
  { id: 'merging', n: '07', label: 'Merging Strategy' },
  { id: 'ai-agents', n: '08', label: 'AI Agents' },
];
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-top">
    <a href="#top" class="brand" data-close-drawer>
      <img src="/brand.png" alt="" class="brand-mark" width="56" height="56" />
      <div class="brand-text">
        <span class="brand-title">The Discipline</span>
        <span class="brand-sub">A GitHub field manual</span>
      </div>
    </a>

    <button
      type="button"
      class="hamburger"
      aria-label="Toggle navigation"
      aria-controls="sidebar-content"
      aria-expanded="false"
      id="hamburger"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="sidebar-content" id="sidebar-content">
    <nav class="nav">
      <span class="nav-eyebrow">Contents</span>
      <ol class="nav-list">
        {chapters.map((c) => (
          <li>
            <a href={`#${c.id}`} data-nav-link data-close-drawer class="nav-link">
              <span class="nav-n">{c.n}</span>
              <span class="nav-label">{c.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <footer class="sidebar-foot">
      <span class="label-mono">v1.0 — Living document</span>
    </footer>
  </div>

  <div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>
</aside>

<script>
  const sidebar = document.getElementById('sidebar');
  const hamburger = document.getElementById('hamburger');
  const backdrop = document.getElementById('drawer-backdrop');

  function setOpen(open: boolean) {
    if (!sidebar || !hamburger) return;
    sidebar.classList.toggle('is-open', open);
    hamburger.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('drawer-locked', open);
  }

  hamburger?.addEventListener('click', () => {
    setOpen(!sidebar?.classList.contains('is-open'));
  });

  backdrop?.addEventListener('click', () => setOpen(false));

  document.querySelectorAll('[data-close-drawer]').forEach((el) => {
    el.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    border-right: 1px solid var(--border-subtle);
    background: linear-gradient(180deg, var(--bg-elev-1) 0%, var(--bg-base) 100%);
    z-index: 20;
    display: flex;
    flex-direction: column;
  }

  .sidebar-top {
    padding: 2rem 1.5rem;
    flex-shrink: 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-primary);
    border-bottom: none;
    margin-bottom: 0;
  }

  .brand-mark {
    width: 56px;
    height: 56px;
    object-fit: contain;
    flex-shrink: 0;
    display: block;
    filter: drop-shadow(0 0 12px rgba(232, 176, 89, 0.2));
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .brand-sub {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .hamburger {
    display: none;
    background: transparent;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    padding: 0.5rem;
    width: 40px;
    height: 40px;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 4px;
  }

  .hamburger span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--text-primary);
    transition: transform 200ms ease, opacity 200ms ease;
  }

  .sidebar-content {
    flex: 1;
    padding: 0 1.5rem 2rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  .nav {
    flex: 1;
    margin-top: 2rem;
  }

  .nav-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-dim);
    display: block;
    margin-bottom: 1rem;
    padding-left: 0.25rem;
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-list li { margin: 0; }

  .nav-link {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.65rem 0.5rem 0.65rem 0.6rem;
    border-radius: var(--radius-sm);
    border-left: 2px solid transparent;
    color: var(--text-muted);
    transition: all 200ms ease;
    border-bottom: none;
    font-size: 0.95rem;
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: var(--bg-elev-2);
  }

  .nav-link.is-active {
    color: var(--text-primary);
    border-left-color: var(--accent-signature);
    background: linear-gradient(90deg, var(--bg-elev-2) 0%, transparent 100%);
  }

  .nav-n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .nav-link.is-active .nav-n {
    color: var(--accent-signature);
  }

  .nav-label {
    font-family: var(--font-sans);
    letter-spacing: -0.005em;
  }

  .sidebar-foot {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .drawer-backdrop {
    display: none;
  }

  /* ============================================================
     Mobile — sidebar collapses to top bar with drawer
     The .sidebar becomes a full-viewport fixed overlay that
     clips the off-screen drawer (so it doesn't cause horizontal
     scroll on iOS Safari). pointer-events: none lets clicks
     pass through to the page underneath.
     ============================================================ */
  @media (max-width: 960px) {
    .sidebar {
      position: fixed;
      inset: 0;
      height: auto;
      width: auto;
      border-right: none;
      background: transparent;
      overflow: hidden;
      pointer-events: none;
      display: block;
      z-index: 19;
    }

    .sidebar-top {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.75rem 1rem;
      background: rgba(13, 17, 23, 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-subtle);
      pointer-events: auto;
      z-index: 22;
    }

    .brand-mark {
      width: 36px;
      height: 36px;
    }

    .brand-title {
      font-size: 1rem;
    }

    .brand-sub {
      font-size: 0.62rem;
    }

    .hamburger {
      display: flex;
    }

    /* Drawer hidden by default (absolute inside the fixed .sidebar overlay) */
    .sidebar-content {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: min(320px, 88vw);
      padding: 5rem 1.5rem 2rem;
      background: var(--bg-elev-1);
      border-left: 1px solid var(--border-subtle);
      transform: translateX(100%);
      transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: -20px 0 60px rgba(0, 0, 0, 0.5);
      pointer-events: none;
      z-index: 21;
    }

    .drawer-backdrop {
      display: block;
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(2px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 300ms ease;
      z-index: 20;
    }

    .sidebar.is-open .sidebar-content {
      transform: translateX(0);
      pointer-events: auto;
    }

    .sidebar.is-open .drawer-backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    .sidebar.is-open .hamburger span:nth-child(1) {
      transform: translateY(5.5px) rotate(45deg);
    }

    .sidebar.is-open .hamburger span:nth-child(2) {
      opacity: 0;
    }

    .sidebar.is-open .hamburger span:nth-child(3) {
      transform: translateY(-5.5px) rotate(-45deg);
    }

    .nav {
      margin-top: 0;
    }
  }
</style>

<style is:global>
  body.drawer-locked {
    overflow: hidden;
  }

  @media (max-width: 960px) {
    .shell {
      grid-template-columns: 1fr !important;
    }
    .main {
      padding-top: 80px;
    }
  }
</style>
